    "typecheck": "tsc --noEmit"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
