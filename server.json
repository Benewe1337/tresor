{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Benewe1337/tresor",
  "description": "Use API tokens without the agent seeing them: keychain, password managers, short-lived creds",
  "version": "0.5.0",
  "repository": {
    "url": "https://github.com/Benewe1337/tresor",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@benewe1337/tresor",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
